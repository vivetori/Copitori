{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/arranque.sh\"",
            "statusMessage": "Comprobando arranque de Copitori"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.claude/logs\" && cat >> \"$CLAUDE_PROJECT_DIR/.claude/logs/auditoria.jsonl\"",
            "async": true,
            "statusMessage": "Registrando auditoría"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(bash .claude/scripts/entorno.sh verificar)",
      "Bash(bash .claude/scripts/entorno.sh reparar-estructura)"
    ],
    "deny": []
  }
}
