# Logs de auditoría de MCPs (crecen sin límite, no versionar). Claude Code y Codex escriben en .claude/logs/.
.claude/logs/
.codex/logs/

# Codex: lo generado (AGENTS.md, .agents/skills/, .codex/agents/) SÍ se versiona; ver .claude/scripts/sincronizar-codex.mjs

# Obsidian — la configuración de la bóveda SÍ se versiona (.obsidian/*.json),
# pero no el estado local de cada persona.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache
.obsidian/plugins/*/data.json
.trash/

# Adjuntos: la carpeta se versiona (su README), el contenido no.
# Son archivos tuyos —o de terceros— y no forman parte de la plantilla.
99_adjuntos/*
!99_adjuntos/README.md

# macOS
.DS_Store

# Node (si agregas scripts/skills con dependencias)
node_modules/
